# Copy this file to ".env" and fill it in. Never share the .env file.

# --- Required ---
ADMIN_PASSWORD=choose-a-long-password
# The public https address of your server (used in the links you send)
PUBLIC_URL=https://leads.yourdomain.com

# --- About you (used in messages and the landing page) ---
MY_NAME=Your Name
COMPANY=Your Studio Name
# The page the "See websites we've built" button opens
PORTFOLIO_URL=https://your-portfolio.com
# Your WhatsApp Business number with country code, digits only (for the "Chat with us" button)
OWNER_WA_NUMBER=919999999999

# --- Automatic lead finder (Google Places API (New)) ---
GOOGLE_API_KEY=
# Hour of the day (0-23, in your time zone) when the daily search runs
DAILY_HOUR=9
# Minutes ahead of UTC. India = 330
TZ_OFFSET_MIN=330
DEFAULT_CC=91
DAILY_LIMIT=50

# --- WhatsApp Cloud API (Meta) ---
WA_TOKEN=
WA_PHONE_ID=
# Any random text you invent; you paste the same text into Meta when setting the webhook
WA_VERIFY_TOKEN=
# Your Meta app secret (App settings -> Basic). Makes the webhook reject fake requests.
WA_APP_SECRET=
# Name of your Meta-approved message template (optional, for opted-in leads only)
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=en

# --- Phone alerts (optional): install the free "ntfy" app, subscribe to a secret topic name ---
NTFY_TOPIC=

# --- Server ---
HOST=127.0.0.1
PORT=8080
# Set to 1 when running behind Caddy/nginx so login attempts are limited per real visitor
TRUST_PROXY=0
